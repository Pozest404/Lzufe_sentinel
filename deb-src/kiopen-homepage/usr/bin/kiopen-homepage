#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""kiopen-homepage — 本地可视化编辑并发布 kiopen.icu 个人主页"""

import argparse
import base64
import json
import os
import shutil
import subprocess
import sys
import threading
import time
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote, urlparse

APP = "kiopen-homepage"
VERSION = "1.0.0"
DEFAULT_DIR = os.path.expanduser("~/kiopen-homepage")
REPO = "https://github.com/Pozest404/Pozest404.github.io.git"
SITE_URL = "https://kiopen.icu/"

EDITOR_CANDIDATES = [
    "/usr/share/kiopen-homepage/editor.html",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "share", "kiopen-homepage", "editor.html"),
]

CONTENT_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".js": "application/javascript; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".gif": "image/gif",
    ".svg": "image/svg+xml",
    ".ico": "image/x-icon",
    ".webp": "image/webp",
    ".woff2": "font/woff2",
    ".txt": "text/plain; charset=utf-8",
}


def editor_path():
    for p in EDITOR_CANDIDATES:
        p = os.path.abspath(p)
        if os.path.isfile(p):
            return p
    return None


def run(cmd, cwd):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=120)
        out = ((p.stdout or "") + (p.stderr or "")).strip()
        return p.returncode, out
    except Exception as exc:  # noqa: BLE001
        return 1, str(exc)


def ensure_exclude(site_dir):
    """把备份目录写入 .git/info/exclude，避免被误提交。"""
    info = os.path.join(site_dir, ".git", "info")
    if not os.path.isdir(os.path.join(site_dir, ".git")):
        return
    try:
        os.makedirs(info, exist_ok=True)
        path = os.path.join(info, "exclude")
        content = ""
        if os.path.isfile(path):
            with open(path, "r", encoding="utf-8") as fh:
                content = fh.read()
        if ".backups/" not in content.splitlines():
            with open(path, "a", encoding="utf-8") as fh:
                if content and not content.endswith("\n"):
                    fh.write("\n")
                fh.write(".backups/\n")
    except OSError:
        pass


def ensure_site(path):
    if os.path.isfile(os.path.join(path, "index.html")):
        ensure_exclude(path)
        return True
    parent = os.path.dirname(os.path.abspath(path))
    os.makedirs(parent, exist_ok=True)
    print("未找到 %s/index.html，正在克隆主页仓库…" % path)
    code, out = run(["git", "clone", REPO, path], parent)
    print(out)
    ok = code == 0 and os.path.isfile(os.path.join(path, "index.html"))
    if ok:
        ensure_exclude(path)
    return ok


class Handler(BaseHTTPRequestHandler):
    site_dir = DEFAULT_DIR

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False).encode("utf-8")
        elif isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, code, obj):
        self._send(code, obj)

    def _body(self):
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length else b""

    def _serve_site(self, rel):
        base = os.path.realpath(self.site_dir)
        target = os.path.realpath(os.path.join(base, rel))
        if not (target == base or target.startswith(base + os.sep)) or not os.path.isfile(target):
            return self._send(404, "Not Found", "text/plain; charset=utf-8")
        ext = os.path.splitext(target)[1].lower()
        with open(target, "rb") as fh:
            data = fh.read()
        return self._send(200, data, CONTENT_TYPES.get(ext, "application/octet-stream"))

    def do_GET(self):  # noqa: N802
        path = urlparse(self.path).path
        if path in ("/", "/index.html"):
            p = editor_path()
            if not p:
                return self._send(500, "安装不完整：找不到 editor.html", "text/plain; charset=utf-8")
            with open(p, "rb") as fh:
                return self._send(200, fh.read(), "text/html; charset=utf-8")
        if path == "/api/info":
            code, remote = run(["git", "remote", "get-url", "origin"], self.site_dir)
            code2, branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], self.site_dir)
            return self._json(200, {
                "dir": self.site_dir,
                "remote": remote if code == 0 else "",
                "branch": branch if code2 == 0 else "",
                "site_url": SITE_URL,
            })
        if path == "/api/site":
            p = os.path.join(self.site_dir, "index.html")
            if not os.path.isfile(p):
                return self._json(404, {"error": "index.html 不存在"})
            with open(p, "rb") as fh:
                return self._send(200, fh.read(), "text/html; charset=utf-8")
        if path == "/favicon.ico":
            return self._send(204, b"", "image/x-icon")
        if path == "/preview" or path.startswith("/preview/"):
            rel = unquote(path[len("/preview"):]).lstrip("/") or "index.html"
            return self._serve_site(rel)
        return self._send(404, "Not Found", "text/plain; charset=utf-8")

    def do_POST(self):  # noqa: N802
        path = urlparse(self.path).path
        if path == "/api/save":
            raw = self._body()
            if not raw:
                return self._json(400, {"error": "内容为空"})
            index = os.path.join(self.site_dir, "index.html")
            backup_dir = os.path.join(self.site_dir, ".backups")
            os.makedirs(backup_dir, exist_ok=True)
            backup = ""
            if os.path.isfile(index):
                stamp = time.strftime("%Y%m%d-%H%M%S") + "-%03d" % (int(time.time() * 1000) % 1000)
                backup = os.path.join(backup_dir, "index-%s.html" % stamp)
                shutil.copy2(index, backup)
            with open(index, "w", encoding="utf-8") as fh:
                fh.write(raw.decode("utf-8", "replace"))
            return self._json(200, {"ok": True, "backup": backup, "bytes": len(raw)})
        if path == "/api/avatar":
            try:
                obj = json.loads(self._body().decode("utf-8"))
                data = obj.get("data", "")
                if "," in data:
                    data = data.split(",", 1)[1]
                blob = base64.b64decode(data)
                if len(blob) > 8 * 1024 * 1024:
                    return self._json(400, {"error": "图片过大（上限 8MB）"})
                with open(os.path.join(self.site_dir, "avatar.png"), "wb") as fh:
                    fh.write(blob)
                return self._json(200, {"ok": True, "bytes": len(blob)})
            except Exception as exc:  # noqa: BLE001
                return self._json(400, {"error": str(exc)})
        if path == "/api/publish":
            d = self.site_dir
            logs = []
            code, out = run(["git", "add", "-A"], d)
            logs.append("$ git add -A\n" + (out or "(无输出)"))
            code, out = run(["git", "diff", "--cached", "--quiet"], d)
            if code == 0:
                return self._json(200, {"ok": True, "changed": False, "output": "没有可发布的改动。\n\n" + "\n\n".join(logs)})
            code, out = run(["git", "commit", "-m", "update homepage: " + time.strftime("%Y-%m-%d %H:%M")], d)
            logs.append("$ git commit\n" + (out or "(无输出)"))
            if code != 0:
                return self._json(200, {"ok": False, "changed": True, "output": "\n\n".join(logs)})
            code, out = run(["git", "push"], d)
            logs.append("$ git push\n" + (out or "(无输出)"))
            return self._json(200, {"ok": code == 0, "changed": True, "output": "\n\n".join(logs)})
        return self._send(404, "Not Found", "text/plain; charset=utf-8")


def serve(site_dir, port, open_browser):
    if not editor_path():
        print("安装不完整：找不到 /usr/share/kiopen-homepage/editor.html")
        sys.exit(1)
    ensure_exclude(site_dir)
    Handler.site_dir = site_dir
    server = None
    for candidate in range(port, port + 10):
        try:
            server = ThreadingHTTPServer(("127.0.0.1", candidate), Handler)
            port = candidate
            break
        except OSError:
            continue
    if server is None:
        server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        port = server.server_address[1]
    url = "http://127.0.0.1:%d/" % port
    print("Kiopen 主页编辑器已启动：%s" % url)
    print("站点目录：%s" % site_dir)
    print("按 Ctrl+C 退出")
    if open_browser:
        threading.Timer(0.8, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n已退出")


def main():
    parser = argparse.ArgumentParser(prog=APP, description="本地可视化编辑并发布 kiopen.icu 个人主页")
    parser.add_argument("command", nargs="?", default="edit", choices=["edit", "serve", "setup", "publish"])
    parser.add_argument("--dir", default=os.environ.get("KIOPEN_HOME", DEFAULT_DIR), help="主页仓库目录")
    parser.add_argument("--port", type=int, default=8765, help="本地端口，默认 8765")
    parser.add_argument("--no-browser", action="store_true", help="不自动打开浏览器")
    parser.add_argument("--version", action="version", version="%s %s" % (APP, VERSION))
    args = parser.parse_args()
    site_dir = os.path.abspath(os.path.expanduser(args.dir))

    if args.command in ("edit", "serve", "publish") and not os.path.isfile(os.path.join(site_dir, "index.html")):
        if not ensure_site(site_dir):
            print("初始化失败。请检查网络，或手动执行：git clone %s %s" % (REPO, site_dir))
            sys.exit(1)

    if args.command == "setup":
        if ensure_site(site_dir):
            print("已就绪：%s" % site_dir)
        else:
            sys.exit(1)
        return

    if args.command == "publish":
        ensure_exclude(site_dir)
        code, out = run(["git", "add", "-A"], site_dir)
        print(out)
        code, out = run(["git", "commit", "-m", "update homepage: " + time.strftime("%Y-%m-%d %H:%M")], site_dir)
        print(out)
        code, out = run(["git", "push"], site_dir)
        print(out)
        sys.exit(0 if code == 0 else 1)

    serve(site_dir, args.port, not args.no_browser and args.command == "edit")


if __name__ == "__main__":
    main()
