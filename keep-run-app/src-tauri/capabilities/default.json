{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Keep Run default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:app:default",
    "core:path:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
