{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keep Run",
  "version": "0.1.0",
  "identifier": "app.keep.run",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Keep Run",
        "width": 1320,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
